if { ![istarget m68k-*-amigaos*] } {
    return
}

# m68k-amigaoself assembles to ELF and links with the ELF emulation by
# default; its amiga emulations turn ELF objects into hunk files.
if { [istarget m68k-*-amigaoself*] } {
    # The amiga emulation has no -z options: keep run_dump_test from
    # adding the ones the default ELF emulation takes.
    global relro_available_saved memory_seal_available_saved
    set relro_available_saved 0
    set memory_seal_available_saved 0
    run_dump_test "amigaoself"
    unset relro_available_saved memory_seal_available_saved
    return
}

run_dump_test "pcrel"
run_dump_test "pcrel-local"
run_dump_test "pcrel-same-name"
run_dump_test "pcrel-local-branch"
run_dump_test "pcrel-byte"
run_dump_test "pcrel-index"
run_dump_test "pcrel-hunk"
run_dump_test "debughunk"
run_dump_test "debug-offset"
run_dump_test "debug-offset-bss"
run_dump_test "elfout"
run_dump_test "elfin"
run_dump_test "elfin-first"
run_dump_test "elfin-r"
run_dump_test "elfin-gc"
run_dump_test "oneonly"
run_dump_test "baserel-text"
run_dump_test "baserel-section"
run_dump_test "weak-override"
run_dump_test "weak-override-local"
run_dump_test "weak-undef"
run_dump_test "weak-undef-r"
run_dump_test "weak-undef-baserel"
run_dump_test "weak-undef-strong"
run_dump_test "weak-undef-strong2"
run_dump_test "weak-undef-strong-r"
run_dump_test "lto-r"
run_dump_test "lto-weak"
run_dump_test "setelem"

# -e makes its symbol undefined, so ld pulls the archive member that
# defines it, as on other targets.
run_ld_link_tests [list \
    [list "Amiga archive for -e" "" "" "" {entry-lib.s} {} "libentry.a"] \
    [list "Amiga -e pulls its symbol from an archive" \
	 "-e _alt" "tmpdir/libentry.a" "" {entry.s} {{nm {} entry.nd}} \
	 "entry"] \
]

# Set elements: ld builds each list as a count, the elements and a zero in
# .data, with a relocation for every element in a section.  The same lists
# come out of a final link of the objects and of an ld -r of them.
run_ld_link_tests [list \
    [list "Amiga set elements" \
	 "-e _start" "" "" {ctor-sets.s} {{objdump {-r -s -j .data} ctor-sets.rd}} \
	 "ctor-sets"] \
    [list "Amiga set elements, ld -r" "-r" "" "" {ctor-sets.s} {} "ctor-sets-r.o"] \
    [list "Amiga set elements after ld -r" \
	 "-e _start tmpdir/ctor-sets-r.o" "" "" {} \
	 {{objdump {-r -s -j .data} ctor-sets.rd}} "ctor-sets-r"] \
]

# A .datachip hunk must stay in chip RAM: a partial link keeps HUNKF_CHIP in
# the HUNK_DATA size word, and a load file has it in the HUNK_HEADER table.
# objdump shows neither, so read the longwords of the files directly.

proc amiga_longs { file } {
    set f [open $file rb]
    binary scan [read $f] Iu* longs
    close $f
    return $longs
}

proc amiga_chip_test {} {
    global as ld srcdir subdir

    set test "Amiga .datachip keeps HUNKF_CHIP"
    if { ![ld_assemble $as $srcdir/$subdir/chip.s tmpdir/chip.o]
	 || ![ld_link $ld tmpdir/chip-r.o "-r tmpdir/chip.o"]
	 || ![ld_link $ld tmpdir/chip "-e _start tmpdir/chip.o"] } {
	fail $test
	return
    }

    # HUNK_DATA (0x3ea) of the 4-byte .datachip, with the chip bit
    set r [amiga_longs tmpdir/chip-r.o]
    set i [lsearch -exact $r [expr 0x3ea]]
    if { $i < 0 || [lindex $r [expr $i + 1]] != [expr 0x40000001] } {
	fail "$test (ld -r)"
	return
    }

    # HUNK_HEADER: 0x3f3, no names, the table size, the first and last
    # hunk, then one size per hunk; the chip data is the last one
    set h [amiga_longs tmpdir/chip]
    set last [lindex $h 4]
    if { [lindex $h 0] != [expr 0x3f3]
	 || [lindex $h [expr 5 + $last]] != [expr 0x40000001] } {
	fail "$test (load file)"
	return
    }
    pass $test
}

amiga_chip_test

# A weak reference does not load an archive member, but still resolves to a
# member that a strong reference loads.  nm on the load file shows g only if
# its member was linked.

proc amiga_weak_archive_test {} {
    global as ar ld nm srcdir subdir

    set test "Amiga weak reference and archive members"
    if { ![ld_assemble $as $srcdir/$subdir/weak-undef.s tmpdir/weak-undef.o]
	 || ![ld_assemble $as $srcdir/$subdir/weak-archive-def.s tmpdir/weak-def.o]
	 || ![ld_assemble $as $srcdir/$subdir/weak-archive-ref.s tmpdir/weak-ref.o]
	 || ![ar_simple_create $ar "" tmpdir/libweak.a tmpdir/weak-def.o]
	 || ![ld_link $ld tmpdir/weak-only \
		"-e main tmpdir/weak-undef.o tmpdir/libweak.a"]
	 || ![ld_link $ld tmpdir/weak-strong \
		"-e main tmpdir/weak-undef.o tmpdir/weak-ref.o tmpdir/libweak.a"] } {
	fail $test
	return
    }

    if { [regexp { T g\n} [run_host_cmd $nm tmpdir/weak-only]] } {
	fail "$test (member loaded)"
	return
    }
    if { ![regexp { T g\n} [run_host_cmd $nm tmpdir/weak-strong]] } {
	fail "$test (member not loaded)"
	return
    }
    pass $test
}

amiga_weak_archive_test
